{
  "name": "@finopsbricks/fob-worker",
  "version": "2.0.0",
  "description": "Local worker-plane CLI for FinOpsBricks: step execution, run-state, and pm2 processes (the fob-orc CLI owns the orchestrator plane)",
  "type": "module",
  "bin": {
    "fob-worker": "./bin/fob-worker.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:finopsbricks/cli-fob.git"
  },
  "keywords": [
    "cli",
    "finopsbricks",
    "process-engine",
    "worker"
  ],
  "author": "FinOpsBricks",
  "license": "Apache-2.0",
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "dotenv": "^16.6.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0"
  }
}
