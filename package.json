{
  "name": "@fob/cli",
  "version": "1.0.0",
  "description": "Developer CLI for FinOpsBricks process engine workers",
  "type": "module",
  "bin": {
    "fob": "./bin/fob.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:finopsbricks/cli.git"
  },
  "keywords": [
    "cli",
    "finopsbricks",
    "process-engine",
    "worker"
  ],
  "author": "FinOpsBricks",
  "license": "PRIVATE",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0"
  }
}
